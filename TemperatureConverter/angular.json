{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "temperature-converter": {
      "projectType": "application",
      "root": "",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "index.html",
            "browser": "main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "styles.scss"
            ],
            "assets": [
              {
                "glob": "temperatureConverter_icon.png",
                "input": ".",
                "output": "."
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "temperature-converter:build:production"
            },
            "development": {
              "buildTarget": "temperature-converter:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
